#!/bin/bash
root=$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )
root="`dirname \"$root\"`"

export PROJECT_ROOT="${root}"
export PATH=$PROJECT_ROOT/bin:$PATH
export PYTHONPATH=$PROJECT_ROOT/src:$PROJECT_ROOT/code:$PROJECT_ROOT/lib:$PROJECT_ROOT/pipeline:$PROJECT_ROOT/solid-garbanzo:$PYTHONPATH
export LUIGI_CONFIG_PATH=$PROJECT_ROOT/luigi.cfg

